# ==============================================
# RENSELL Backend Environment Variables (backend/.env)
# ==============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/rensell

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Vercel Blob Storage (optional - falls back to local backend/uploads/)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Optional: Upstash Redis for distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================
# RENSELL Frontend Environment Variables (frontend/.env)
# ==============================================
VITE_API_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
